# ============================================================
# 自适应 RAG 系统 — 生产环境配置模板
# 使用方法：复制为 .env 后填入真实密钥
#   cp .env.production .env
#   vim .env  （只改 xxx 占位符为真实值即可）
# ============================================================

# ---- LLM 后端（必填）----
LLM_BACKEND=tongyi
TONGYI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
TONGYI_MODEL=qwen-plus-latest
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 网络搜索（必填）----
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ---- 向量数据库（必填，二选一）----
# 方案1：Zilliz Cloud（推荐生产环境）
MILVUS_URI=https://in03-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# 方案2：Milvus Lite 本地文件（开发测试用，注释掉上面的即可）
# MILVUS_URI=./milvus_rag.db
# MILVUS_PASSWORD=

# ---- 功能开关 ----
ENABLE_MULTIMODAL=false
ENABLE_ADVANCED_RERANKER=false
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_EXPANSION=true
ENABLE_GRAPH_RAG=true

# ---- LangSmith 追踪（可选，删除或留空则不启用）----
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
# LANGSMITH_TRACING=True
# LANGSMITH_PROJECT=adaptive-rag-project
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- 会话持久化（可选）----
# docker-compose 部署时自动设置为 redis://redis:6379/0，无需手动配置
# 单独部署时可填写 Redis Cloud 或自建 Redis 地址
# REDIS_URL=redis://default:password@host:port/0
# REDIS_SESSION_TTL=604800
